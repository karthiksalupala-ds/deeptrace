# DeepTrace local development configuration
# Copy this file to .env for local use. Never commit real secrets.

# Local storage is the supported zero-configuration MVP backend.
STORAGE_BACKEND=local

# Optional frontend/backend URLs for tooling and documentation.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Optional future Supabase configuration.
# These are intentionally blank until Supabase storage is implemented.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
